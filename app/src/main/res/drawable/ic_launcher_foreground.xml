    <path
        android:pathData="M34,34.6L48,55.6L34,76.6M74,34.6L60,55.6L74,76.6"
        android:strokeWidth="10"
        android:strokeColor="#22000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
