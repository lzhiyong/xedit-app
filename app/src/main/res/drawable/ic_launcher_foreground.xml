        android:pathData="M34,34.2L48,55.2L34,76.2M74,34.2L60,55.2L74,76.2"
        android:strokeWidth="9"
        android:strokeColor="#22000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- ">" -->
    <path
        android:pathData="M34,33L48,54L34,75"
        android:strokeWidth="8.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- "<" -->
    <path
        android:pathData="M74,33L60,54L74,75"
