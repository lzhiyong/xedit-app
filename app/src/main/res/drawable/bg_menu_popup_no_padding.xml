<?xml version="1.0" encoding="utf-8"?>
<!-- bg_menu_popup without its padding: for the lists that lay out their own room (the list
     of open files, the search history), whose heights are counted without one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/menu_popup_corner" />
    <solid android:color="?attr/colorSurfaceContainerHighest" />
    <stroke
        android:width="1dp"
        android:color="@color/menu_popup_stroke" />
</shape>
