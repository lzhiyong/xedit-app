<?xml version="1.0" encoding="utf-8"?>
<!-- ✕ on the top right corner of a file attached to what is being written (item_agent_attachment):
     a circle of 22dp with a thin outline, in the middle of the 30dp button; a faint ripple in
     the circle when pressed -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item
        android:id="@android:id/mask"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="?attr/colorSurfaceContainerHighest" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorOutline" />
        </shape>
    </item>
</ripple>
