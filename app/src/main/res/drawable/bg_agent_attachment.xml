<?xml version="1.0" encoding="utf-8"?>
<!-- a file attached to a message of the AI assistant (item_agent_attachment): a card, its
     outline (and the thumbnail of an image, clipped to it: AgentSheet.bindAttachment) rounded -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
</shape>
