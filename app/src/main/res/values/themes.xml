<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The theme of the app (its dark version is in values-night). -->
    <style name="Theme.XEdit" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!--
        The editor screen: the app theme (light or dark, from values or values-night), its
        menus set off from the editor, see Widget.XEdit.MenuPopup.
    -->
    <style name="Theme.XEdit.Editor">
        <item name="popupMenuStyle">@style/Widget.XEdit.MenuPopup</item>
        <item name="actionOverflowMenuStyle">@style/Widget.XEdit.MenuPopup.Overflow</item>
        <item name="listPopupWindowStyle">@style/Widget.XEdit.MenuPopup.ListPopupWindow</item>
    </style>

    <!--
        Over the theme of the editor's menus (the toolbar's popupTheme: the overflow menu and
        its sub-menus; full screen's menu): what ends an item lines up on the right. Out of
        the box the checkbox (Auto wrap) is a 48dp touch target with its box centered in it,
        and the arrow of a sub-menu (Developer tools, AppCompat's own icon) 24dp, so the box
        stood 12dp to the left of the arrow. Here the checkbox is as wide as the arrow
        (R.dimen.menu_trailing_size), its box centered. Only the menus get it: the
        checkboxes of the sheets and dialogs stay as they are.
    -->
    <style name="ThemeOverlay.XEdit.EditorMenu" parent="">
        <item name="checkboxStyle">@style/Widget.XEdit.MenuCheckBox</item>
    </style>

    <!--
        The pure black dark theme ("pure black dark theme" in the settings): laid
        over the dark theme by BaseActivity. The background is black, and the
        surfaces the cards and bars use step up from it a little, so they still
        stand out.
    -->
    <style name="ThemeOverlay.XEdit.PureBlack" parent="">
        <item name="android:colorBackground">@color/pure_black</item>
        <item name="colorSurface">@color/pure_black</item>
        <item name="colorSurfaceDim">@color/pure_black</item>
        <item name="colorSurfaceBright">#FF262626</item>
        <item name="colorSurfaceContainerLowest">@color/pure_black</item>
        <item name="colorSurfaceContainerLow">#FF0C0C0C</item>
        <item name="colorSurfaceContainer">#FF121212</item>
        <item name="colorSurfaceContainerHigh">#FF1A1A1A</item>
        <item name="colorSurfaceContainerHighest">#FF222222</item>
    </style>
</resources>
