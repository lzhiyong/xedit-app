<?xml version="1.0" encoding="utf-8"?>
<menu
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <item
        android:id="@+id/action_undo"
        android:title="@string/action_undo"
        android:icon="@drawable/ic_undo"
        app:showAsAction="always"/>
        
    <item
        android:id="@+id/action_redo"
        android:title="@string/action_redo"
        android:icon="@drawable/ic_redo"
        app:showAsAction="always"/>
    
    <item
        android:id="@+id/action_save_file"
        android:title="@string/action_save_file"
        android:icon="@drawable/ic_save"
        app:showAsAction="always"/>
    <!-- compile and run the file (a long press: the command, see RunSettingsDialog) -->
    <item
        android:id="@+id/action_run"
        android:title="@string/action_run"
        android:icon="@drawable/ic_run"
        app:showAsAction="always"/>
        
    <item
        android:id="@+id/action_add_folder"
        android:title="@string/action_add_folder"
        android:icon="@drawable/ic_folder"
        app:showAsAction="never"/>
        
    <item
        android:id="@+id/action_open_file"
        android:title="@string/action_open_file"
        android:icon="@drawable/ic_file"
        app:showAsAction="never"/>

    <!-- edit mode or read-only mode: its title says which it turns to -->
            
    <item
        android:id="@+id/action_edit_mode"
        android:title="@string/action_edit_mode"
        android:icon="@drawable/ic_read_write"
        app:showAsAction="never"/>
        
    <item
        android:id="@+id/action_search"
        android:title="@string/action_search"
        android:icon="@drawable/ic_search"
        app:showAsAction="never"/>

    <!-- right under search: to a line (and column) of the file -->
    <item
        android:id="@+id/action_goto_line"
        android:title="@string/action_goto_line"
        android:icon="@drawable/ic_goto_line"
        app:showAsAction="never"/>
        
    <!-- right under search: wraps long lines, or not (checked while on) -->
    <item
        android:id="@+id/action_wordwrap"
        android:title="@string/action_wordwrap"
        android:icon="@drawable/ic_wrap_text"
        android:checkable="true"
        app:showAsAction="never"/>

    <!-- full screen on or off: the toolbar and the tabs give way to a slim bar
         (FullscreenController); its title and icon say what a tap turns it to -->
    <item
        android:id="@+id/action_fullscreen"
        android:title="@string/action_fullscreen"
        android:icon="@drawable/ic_fullscreen"
        app:showAsAction="never"/>
        
    <!-- developer tools, in a menu of their own so the overflow menu stays short (it opens
         in the menu itself, with ← back: CascadeMenu) -->
    <item
        android:id="@+id/action_dev_tools"
        android:title="@string/action_dev_tools"
        android:icon="@drawable/ic_code"
        app:showAsAction="never">
        <menu>
            <!-- the AI assistant: a model working on the files of the project shown (agent/AgentSheet) -->
            <item
                android:id="@+id/action_agent"
                android:title="@string/action_agent"
                android:icon="@drawable/ic_agent" />

            <!-- compilers, language servers and tools installed into the app's own usr (ToolchainSheet) -->
            <item
                android:id="@+id/action_toolchain"
                android:title="@string/toolchain_title"
                android:icon="@drawable/ic_picker_wrench" />

            <!-- the language servers, a file each, and how they are doing (LanguageServersSheet) -->
            <item
                android:id="@+id/action_lsp_config"
                android:title="@string/action_lsp_config"
                android:icon="@drawable/ic_lsp_config" />

            <!-- the rules documents are formatted with (FormattingSheet: the rules file of the
                 document's language, edited there, and a preview of the document); formatting
                 itself is in the floating bar -->
            <item
                android:id="@+id/action_format_rules"
                android:title="@string/action_format_rules"
                android:icon="@drawable/ic_format_paint" />

            <!-- the user's own snippets, file by file (SnippetsSheet); Edit opens the one of the document's language -->
            <item
                android:id="@+id/action_snippets"
                android:title="@string/action_snippets"
                android:icon="@drawable/ic_snippets" />

            <!-- the shortcuts as they are (ShortcutsSheet); "Edit" there opens keymap.json (KeymapFile) -->
            <item
                android:id="@+id/action_shortcuts"
                android:title="@string/action_shortcuts"
                android:icon="@drawable/ic_keyboard" />

            <!-- highlight themes of the user's own, made and edited with a preview (ThemeSheet);
                 which one is used is chosen in the settings -->
            <item
                android:id="@+id/action_create_theme"
                android:title="@string/action_create_theme"
                android:icon="@drawable/ic_palette" />
        </menu>
    </item>

    <!-- the console: output, problems, build (ConsoleSheet) -->
    <item
        android:id="@+id/action_console"
        android:title="@string/action_console"
        android:icon="@drawable/ic_console"
        app:showAsAction="never"/>

    <item
        android:id="@+id/action_settings"
        android:title="@string/action_settings"
        android:icon="@drawable/ic_settings"
        app:showAsAction="never"/>

    <!-- ⋮ on the toolbar: the items above that are not buttons of the toolbar, in a menu of
         the app's own (CascadeMenu, EditorActivity.showOverflowMenu); the toolbar's own
         overflow menu is never shown (those items are hidden on the toolbar). Ordered after
         every other item: last on the toolbar, whatever is added to it. -->
    <item
        android:id="@+id/action_overflow"
        android:title="@string/action_more"
        android:icon="@drawable/ic_more_vert"
        android:orderInCategory="1000"
        app:showAsAction="always"/>

</menu>
