<?xml version="1.0" encoding="utf-8"?>
<!--
    The layers have names of their own (ic_xedit_launcher_*), not the template's
    ic_launcher_foreground: a leftover template file of that name in another
    folder, drawable-v24 say, would otherwise be picked over these on Android 7+.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_xedit_launcher_background" />
    <foreground android:drawable="@drawable/ic_xedit_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_xedit_launcher_monochrome" />
</adaptive-icon>
