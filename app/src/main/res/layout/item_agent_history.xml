<?xml version="1.0" encoding="utf-8"?>
<!-- One kept chat in the history of the AI assistant (AgentSheet.showHistory): a speech
     bubble, then the name of the chat (what the user asked first, or what he renamed it to)
     and under it when it was last written to and how long it is; 📌 at the end of a chat
     kept at the top. A tap takes it up again, a long press opens the menu of the row (pin,
     rename, delete) — there is no button on the row itself. The chat shown now sits on a
     rounded surface, its icon and name in the accent colour (bg_agent_history_row_current,
     set by the adapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_agent_history_row"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/agent_history_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chat_bubble"
        android:tint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/agent_history_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/agent_history_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <ImageView
        android:id="@+id/agent_history_pin"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/agent_history_pinned"
        android:src="@drawable/ic_push_pin"
        android:visibility="gone"
        android:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
