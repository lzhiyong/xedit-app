<?xml version="1.0" encoding="utf-8"?>
<!-- a tool call (AgentSheet): what and where, how it is going; what it changes (a diff, the
     command), with Allow / Allow all in this chat / Deny while it waits for the user; what
     it came to, folded (a tap unfolds it), what read_file and run_command came to in a code
     block; View and Open for a file it changed or read -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="2dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/agent_tool_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/agent_tool_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/agent_tool_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <TextView
                android:id="@+id/agent_tool_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/agent_tool_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/agent_tool_preview_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_agent_preview"
            android:scrollbars="none">

            <x.editor.app.view.SelectableTextView
                android:id="@+id/agent_tool_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:padding="8dp"
                android:textIsSelectable="true"
                android:textSize="11sp" />

        </HorizontalScrollView>

        <!-- what read_file, list_files, search_files and run_command came to, in a code
             block (AgentCodeBlock), unfolded -->
        <FrameLayout
            android:id="@+id/agent_tool_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <x.editor.app.view.SelectableTextView
            android:id="@+id/agent_tool_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/agent_tool_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/agent_tool_deny"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/agent_deny" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/agent_tool_allow_chat"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/agent_allow_in_chat" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/agent_tool_allow"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/agent_allow" />

        </LinearLayout>

        <!-- the file it wrote, changed or read: View (only to look at, CodeViewer), Open (in the editor) -->
        <LinearLayout
            android:id="@+id/agent_tool_file_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/agent_tool_view"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agent_view_file" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/agent_tool_open"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agent_open_file" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
