<?xml version="1.0" encoding="utf-8"?>
<!-- CodeViewer: a code block of the AI assistant, or a file it wrote or read, only to look
     at. The head (dragged by it only, as the sheets of the developer tools): what it is, its
     language and lines; Word wrap, Copy all, Close. Under it the text in an editor of the
     app that cannot be edited: highlighted, with line numbers, laid out in the background
     (a large file too, as the editor shows it); a long press selects, and the floating bar
     copies or selects all. The editor keeps its touches: a drag on it scrolls its text, not
     the sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/viewer_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/viewer_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/viewer_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewer_wrap"
                style="@style/Widget.XEdit.SmallIconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/viewer_wrap"
                android:tooltipText="@string/viewer_wrap"
                app:icon="@drawable/ic_wrap_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewer_copy"
                style="@style/Widget.XEdit.SmallIconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/viewer_copy_all"
                android:tooltipText="@string/viewer_copy_all"
                app:icon="@drawable/ic_content_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewer_close"
                style="@style/Widget.XEdit.SmallIconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/viewer_close"
                android:tooltipText="@string/viewer_close"
                app:icon="@drawable/ic_close" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <x.editor.app.view.CodeEditorView
            android:id="@+id/viewer_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/viewer_message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/viewer_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
