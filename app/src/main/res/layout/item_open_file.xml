<?xml version="1.0" encoding="utf-8"?>
<!--
    A row of the list of open files (a tap on the title of the toolbar): the file icon,
    its name and, while it has unsaved changes, a dot. The row of the document shown has
    a tinted, rounded background and its name in the primary color (EditorTabsController).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/open_file_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/open_files_row_height"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/open_file_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_file" />

        <TextView
            android:id="@+id/open_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <ImageView
            android:id="@+id/open_file_modified"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tab_modified"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
