<?xml version="1.0" encoding="utf-8"?>
<!-- An action of the dialog of an entry (dialog_entry_actions): its icon, what it is and a
     line on what it does. One that cannot be done now is dimmed, its line says why. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="?attr/dialogPreferredPadding"
    android:paddingTop="10dp"
    android:paddingEnd="?attr/dialogPreferredPadding"
    android:paddingBottom="10dp">

    <!-- the icon on a rounded tonal square, as the sections have them (tinted in code: the
         error color for removing) -->
    <FrameLayout
        android:id="@+id/entry_action_icon_box"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_section_icon"
        android:backgroundTint="@color/section_icon_background">

        <ImageView
            android:id="@+id/entry_action_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:tint="@color/section_icon_tint"
            tools:ignore="ContentDescription" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/entry_action_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/entry_action_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</LinearLayout>
