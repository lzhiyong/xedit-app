<?xml version="1.0" encoding="utf-8"?>
<x.editor.app.view.ContentTranslatingDrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="?attr/colorSurfaceDim"
    android:animateLayoutChanges="true"
    tools:ignore="DuplicateIncludedIds">
    
    <!-- main content layout -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout 
        android:id="@+id/content_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    
        <!-- app bar layout -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="10dp">

                <!-- While a document is loaded or saved, or its text laid out again:
                     a small spinner at the end of the toolbar, before the actions -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="22dp"
                    app:trackThickness="2.5dp"
                    app:trackCornerRadius="2dp"/>

            </com.google.android.material.appbar.MaterialToolbar>

            <!-- the open documents, one tab each; hidden while there are none -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/editor_tabs"
                style="@style/Widget.XEdit.EditorTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
        
        </com.google.android.material.appbar.AppBarLayout>
        
        <!-- editor content layout -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
           
            <!-- the editors, one per open document (see EditorActivity): only the one
                 of the selected tab is shown -->
            <FrameLayout
                android:id="@+id/editor_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- no document open -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.5"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_code"
                    android:tint="?attr/colorOnSurfaceVariant"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/editor_empty"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

            </LinearLayout>
    
            <!-- The row of extra keys over the keyboard (see ExtraKeysController): Tab,
                 the symbols of the settings (they scroll), and the arrow keys. While
                 the completion list is shown, Tab takes the selected item and up and
                 down move through the list. The keyboard (or the navigation bar) pads
                 it from below, see ImeAnimationInsetsHandler. -->
            <LinearLayout
                android:id="@+id/extra_keys_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:background="?attr/colorSurfaceContainer"
                android:clickable="true"
                android:focusable="false"
                android:soundEffectsEnabled="false">

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/extra_keys_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerThickness="1dp"/>

                <LinearLayout
                    android:id="@+id/extra_keys_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/extra_keys_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/extra_keys_padding_horizontal"
                    android:paddingEnd="@dimen/extra_keys_padding_horizontal">

                    <!-- Tab; takes the selected completion while the list is shown -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/extra_key_tab"
                        style="@style/Widget.XEdit.ExtraKey"
                        android:layout_width="@dimen/extra_key_wide_width"
                        android:layout_height="@dimen/extra_key_height"
                        android:contentDescription="@string/extra_key_tab"
                        app:icon="@drawable/ic_keyboard_tab"/>

                    <!-- Ctrl and Alt: a tap latches them for the next key (a char of the
                         soft keyboard, a symbol of the row), a long press until tapped
                         again; the keys are looked up in the keymap (keymap.json) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/extra_key_ctrl"
                        style="@style/Widget.XEdit.ExtraKey.Modifier"
                        android:layout_width="@dimen/extra_key_wide_width"
                        android:layout_height="@dimen/extra_key_height"
                        android:layout_marginStart="@dimen/extra_key_gap"
                        android:contentDescription="@string/extra_key_ctrl"
                        android:text="Ctrl"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/extra_key_alt"
                        style="@style/Widget.XEdit.ExtraKey.Modifier"
                        android:layout_width="@dimen/extra_key_wide_width"
                        android:layout_height="@dimen/extra_key_height"
                        android:layout_marginStart="@dimen/extra_key_gap"
                        android:contentDescription="@string/extra_key_alt"
                        android:text="Alt"/>

                    <!-- the symbols, from the settings -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/extra_keys_list"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/extra_key_height"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/extra_key_gap"
                        android:layout_marginEnd="@dimen/extra_key_gap"
                        android:clipToPadding="false"
                        android:fadingEdgeLength="20dp"
                        android:overScrollMode="never"
                        android:requiresFadingEdge="horizontal"
                        android:scrollbars="none"/>

                    <!-- the arrow keys, as one group; folded away by the key after it, so
                         that the symbols get the room (out by themselves while the
                         completion list is shown, see ExtraKeysController) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/extra_keys_arrows"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/extra_key_height"
                        app:cardCornerRadius="@dimen/extra_key_corner"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/extra_key_left"
                                style="@style/Widget.XEdit.ExtraKey.Arrow"
                                android:layout_width="@dimen/extra_key_arrow_width"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/extra_key_left"
                                app:icon="@drawable/ic_key_left"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/extra_key_up"
                                style="@style/Widget.XEdit.ExtraKey.Arrow"
                                android:layout_width="@dimen/extra_key_arrow_width"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/extra_key_up"
                                app:icon="@drawable/ic_key_up"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/extra_key_down"
                                style="@style/Widget.XEdit.ExtraKey.Arrow"
                                android:layout_width="@dimen/extra_key_arrow_width"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/extra_key_down"
                                app:icon="@drawable/ic_key_down"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/extra_key_right"
                                style="@style/Widget.XEdit.ExtraKey.Arrow"
                                android:layout_width="@dimen/extra_key_arrow_width"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/extra_key_right"
                                app:icon="@drawable/ic_key_right"/>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- shows or folds away the arrow keys -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/extra_key_arrows_toggle"
                        style="@style/Widget.XEdit.ExtraKey.Toggle"
                        android:layout_width="@dimen/extra_key_toggle_width"
                        android:layout_height="@dimen/extra_key_height"
                        android:layout_marginStart="@dimen/extra_key_gap"
                        android:contentDescription="@string/extra_key_arrows_expand"
                        app:icon="@drawable/ic_key_arrows"/>

                </LinearLayout>
            </LinearLayout>

            <!-- download panel, under the toolbar -->
            <include
                android:id="@+id/download_panel"
                layout="@layout/view_download_panel"/>

            <!-- search and replace panel, along the bottom edge -->
            <include
                android:id="@+id/search_panel"
                layout="@layout/view_search_panel"/>
    
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>       
    
    <!-- navigation view start -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_start"
        android:layout_gravity="start"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        app:insetForeground="@android:color/transparent">
        
        <!-- file tree: external storage, the added folders and the opened files -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/file_tree_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:scrollbars="vertical|horizontal"/>
                
    </com.google.android.material.navigation.NavigationView>

</x.editor.app.view.ContentTranslatingDrawerLayout>

