<?xml version="1.0" encoding="utf-8"?>
<!-- What can be done with an entry of a sheet of the developer tools, on a long press on it
     (EntryActionsDialog: a theme of ThemeSheet, a server of LanguageServersSheet): a head
     that shows it (a tile: for a theme "Aa" in its keyword color on its background, for a
     server its badge; its name; a line on it (a theme's; a server has none); a badge such as
     "In use" or "Running"; for a theme its colors as swatches), then the actions, a row each
     with an icon and a line on what it does (item_entry_action). What went wrong with a server
     is not shown here: a tap on its row shows it (EntryProblemPopup). -->
<!-- It scrolls: on a small screen, or in landscape, the last actions (Remove) are never
     out of reach. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="?attr/dialogPreferredPadding"
        android:paddingEnd="?attr/dialogPreferredPadding">

        <!-- the theme at a glance: its background, "Aa" in the color of its keywords -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/entry_actions_tile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/entry_actions_tile_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/entry_actions_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface" />

                <!-- what it is now: "In use", "Running" -->
                <TextView
                    android:id="@+id/entry_actions_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/entry_actions_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- a theme's colors: the background, then those of keywords, strings, functions, types, numbers -->
    <x.editor.app.preference.SwatchesView
        android:id="@+id/entry_actions_swatches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/dialogPreferredPadding"
        android:layout_marginTop="14dp" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="6dp" />

    <!-- the actions (item_entry_action), added by EntryActionsDialog -->
    <LinearLayout
        android:id="@+id/entry_actions_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>
