<?xml version="1.0" encoding="utf-8"?>
<!--
    The view of a tab of an open document: a ring while it is being loaded with another
    document shown (the one shown has the bar under the toolbar), its name and a button
    that closes it.
    The name has the id TabLayout looks for (android:id/text1), so the tab sets its
    text and gives it the selected and unselected colors. While the document has
    unsaved changes the button shows a dot instead of the cross (a tap still closes).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/tab_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorInset="0dp"
        app:indicatorSize="14dp"
        app:trackColor="@android:color/transparent"
        app:trackCornerRadius="1dp"
        app:trackThickness="2dp" />

    <TextView
        android:id="@android:id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxWidth="180dp"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="@color/editor_tab_text" />

    <ImageButton
        android:id="@+id/tab_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tab_close"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        android:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
