<?xml version="1.0" encoding="utf-8"?>
<!-- What the model said, across the width (AgentSheet): Thinking (the busy dots) while it has
     said nothing yet; then its parts in order, the text (a little Markdown, AgentMarkdown)
     and each code block in an editor of the app (AgentCodeBlock), in agent_blocks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/agent_thinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:text="@string/agent_thinking"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <LinearLayout
        android:id="@+id/agent_blocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
