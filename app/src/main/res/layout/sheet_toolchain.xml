<?xml version="1.0" encoding="utf-8"?>
<!-- The toolchain (ToolchainSheet), everything on one sheet: what the list shows (all, or
     what is installed), and the toolchains of packages.json, each installed into X Editor or
     not, in a list of a height of its own. ⓘ by the title (as on every panel of the developer
     tools); packages.json in an editor on the sheet (SheetFileEditor), under the title, shown
     by Edit of a toolchain or New; Update (by the list: its dots go round while it works) and
     New. Termux is not on it: its tools are installed by the user, in Termux.

     The drag handle is above what scrolls, not in it: it stays at the top of the sheet,
     which is dragged by it only (HandleDragSheetDialog). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/toolchain_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <x.editor.app.view.FocusStableScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/toolchain_title_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolchain_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <!-- ⓘ: what the panel is for, how it is used, where packages.json is; Export all -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolchain_help"
                    style="@style/Widget.XEdit.SmallIconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/help_title"
                    android:tooltipText="@string/help_title"
                    app:icon="@drawable/ic_about" />

            </LinearLayout>

            <!-- packages.json, edited in place (SheetFileEditor); hidden until a toolchain is edited, or New -->
            <FrameLayout
                android:id="@+id/toolchain_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <!-- what the list shows: all the toolchains, or those installed into X Editor -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/toolchain_show"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toolchain_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolchain_filter_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolchain_filter_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolchain_filter_installed"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolchain_filter_installed" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/toolchain_filter_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- the toolchains of packages.json (what a save of it installs shows by it once
                 the editor is hidden: ToolchainSheet) -->
            <LinearLayout
                android:id="@+id/toolchain_list_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/toolchain_packages"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <!-- Update: the list read again, then what is installed into X Editor updated;
                     while it goes on, its icon is three dots going round; not enabled while the
                     list shows nothing (ToolchainSheet) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolchain_refresh"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/toolchain_refresh"
                    app:icon="@drawable/ic_update" />

                <!-- New: a toolchain put at the end of packages.json in the editor -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolchain_new"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/config_new"
                    app:icon="@drawable/ic_add" />

            </LinearLayout>

            <!-- the toolchains (all, or those installed, as the buttons above say): as many
                 as fit its height (ToolchainSheet), then it scrolls. The frame keeps the height of
                 the whole list, so that switching never makes the sheet jump; when nothing is to
                 be shown, an icon and a few words say why, in its middle. -->
            <FrameLayout
                android:id="@+id/toolchain_list_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp">

                <x.editor.app.view.MaxHeightRecyclerView
                    android:id="@+id/toolchain_packages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="vertical" />

                <!-- why nothing is shown, in its middle: an icon of what is wrong (a ring while
                     it is busy), a few large words, and a small line under them. A
                     tap on the icon shows all of why, and what to do, in a window under it
                     (EntryProblemPopup, as the footer's ⋯ does). -->
                <LinearLayout
                    android:id="@+id/toolchain_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/toolchain_empty_icon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:clickable="true"
                        android:contentDescription="@string/toolchain_empty_details"
                        android:focusable="true"
                        android:tooltipText="@string/toolchain_empty_details">

                        <ImageView
                            android:id="@+id/toolchain_empty_image"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_picker_wrench" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/toolchain_empty_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorInset="0dp"
                            app:indicatorSize="30dp"
                            app:trackThickness="3dp"
                            app:trackCornerRadius="1.5dp"
                            app:trackColor="@android:color/transparent" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/toolchain_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:maxWidth="280dp"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/toolchain_empty_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/toolchain_empty_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </FrameLayout>

            <!-- the footer: a line of what the toolchains are (two at most), and ⋯ by it,
                 which shows all of it in a window (EntryProblemPopup; a tap on the line too) -->
            <LinearLayout
                android:id="@+id/toolchain_footer_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/toolchain_footer_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="2"
                    android:text="@string/toolchain_footer_short"
                    android:textAlignment="viewStart"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolchain_footer_more"
                    style="@style/Widget.XEdit.SmallIconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/toolchain_footer_more"
                    android:tooltipText="@string/toolchain_footer_more"
                    app:icon="@drawable/ic_more_horiz" />

            </LinearLayout>

        </LinearLayout>

    </x.editor.app.view.FocusStableScrollView>

</LinearLayout>
