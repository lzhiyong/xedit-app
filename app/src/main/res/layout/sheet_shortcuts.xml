<?xml version="1.0" encoding="utf-8"?>
<!-- The shortcuts (ShortcutsSheet), with the parts of every panel of the developer tools
     (as sheet_config_list): the drag handle; the title with ⓘ; the status card (how many
     mappings, how many left out, and a step to see them); keymap.json in an editor, hidden
     at first (SheetFileEditor); the tabs (a group of commands each, the mappings that insert
     text, the user's own, and + to make a tab); the title of the list with New (a mapping);
     the rows of the tab shown, in a list of a height of its own (or why it is empty and the
     button that makes one); and where keymap.json is (a tap copies it).
     The drag handle is above what scrolls, not in it (HandleDragSheetDialog). The scroll view
     stays put when the editor takes the focus (FocusStableScrollView). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/shortcuts_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <x.editor.app.view.FocusStableScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/shortcuts_title_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_shortcuts"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shortcuts_help"
                    style="@style/Widget.XEdit.SmallIconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/help_title"
                    android:tooltipText="@string/help_title"
                    app:icon="@drawable/ic_about" />

            </LinearLayout>

            <!-- how it stands: a dot, a title, a line; at most one next step -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/shortcuts_status_card"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <View
                        android:id="@+id/shortcuts_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/shortcuts_status_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <!-- <leader> and how long the next key of a sequence is waited for -->
                        <TextView
                            android:id="@+id/shortcuts_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shortcuts_status_action"
                        style="@style/Widget.XEdit.SmallButton.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/shortcut_status_see_ignored"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- keymap.json, edited in place (SheetFileEditor); hidden until an entry is edited -->
            <FrameLayout
                android:id="@+id/shortcuts_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <!-- the tabs (the last, +, makes a tab of the user's own) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/shortcuts_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                app:tabGravity="start"
                app:tabMode="scrollable" />

            <!-- the title of the list, and New: a mapping -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/shortcuts_list_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <!-- a tab of the user's own: deleted (its mappings go back to their commands' tabs) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shortcuts_tab_delete"
                    style="@style/Widget.XEdit.SmallIconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/shortcut_delete_tab_action"
                    android:tooltipText="@string/shortcut_delete_tab_action"
                    android:visibility="gone"
                    app:icon="@drawable/ic_delete" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shortcuts_new"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/config_new"
                    app:icon="@drawable/ic_add" />

            </LinearLayout>

            <!-- the rows of the tab shown: as many as fit its height, then it scrolls -->
            <x.editor.app.view.MaxHeightRecyclerView
                android:id="@+id/shortcuts_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:overScrollMode="never"
                android:scrollbars="vertical" />

            <!-- a tab with no rows: an icon, a sentence, and New -->
            <LinearLayout
                android:id="@+id/shortcuts_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_section_icon">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_keyboard"
                        app:tint="?attr/colorPrimary" />

                </FrameLayout>

                <TextView
                    android:id="@+id/shortcuts_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:maxWidth="280dp"
                    android:text="@string/shortcut_empty_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shortcuts_empty_action"
                    style="@style/Widget.XEdit.SmallButton.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/shortcut_new_mapping"
                    app:icon="@drawable/ic_add" />

            </LinearLayout>

            <TextView
                android:id="@+id/shortcuts_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="6dp"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableEndCompat="@drawable/ic_content_copy"
                app:drawableTint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </x.editor.app.view.FocusStableScrollView>

</LinearLayout>
