<?xml version="1.0" encoding="utf-8"?>
<!-- The shortcuts as keymap.json has them (ShortcutsSheet): the commands in their groups,
     each a card of rows as in the settings, the keys drawn as caps, then the mappings that
     insert text. "Edit" opens keymap.json in the editor. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_shortcuts"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <!-- <leader> and how long the next key of a sequence is waited for -->
                <TextView
                    android:id="@+id/shortcuts_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shortcuts_edit"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/shortcut_edit"
                app:icon="@drawable/ic_edit" />

        </LinearLayout>

        <!-- what was left out of keymap.json when it was read last, and why -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/shortcuts_problems_card"
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:strokeColor="?attr/colorError">

            <TextView
                android:id="@+id/shortcuts_problems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:padding="12dp"
                android:textColor="?attr/colorError"
                android:textSize="12sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- the groups, filled in by ShortcutsSheet -->
        <LinearLayout
            android:id="@+id/shortcuts_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
