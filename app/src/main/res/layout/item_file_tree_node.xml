<!-- Dimensions must match FileTreeMetrics; the start padding (indentation) is set in code per depth.
     The ripple of a tap or a long press is the foreground: the background is the highlight of the
     open document (FileTreeAdapter.bindHighlight), which would replace a ripple background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="52dp"
    android:foreground="@drawable/ripple_effect"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Expansion indicator (▶ / ▼); a small progress bar replaces it while loading. -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/arrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp" />
</LinearLayout>
