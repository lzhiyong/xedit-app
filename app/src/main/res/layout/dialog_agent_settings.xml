<?xml version="1.0" encoding="utf-8"?>
<!-- The AI assistant's settings (AgentSheet.showSettings): the provider, its address, model,
     key and level of thinking (each provider keeps its own), the length of an answer, what
     is asked first. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/agent_provider"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <RadioGroup
            android:id="@+id/agent_provider_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/agent_provider_anthropic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/agent_provider_anthropic" />

            <RadioButton
                android:id="@+id/agent_provider_openai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/agent_provider_openai" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/agent_base_url_layout"
            style="?attr/textInputOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/agent_base_url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/agent_base_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="?attr/textInputOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/agent_model_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/agent_model_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text|textNoSuggestions"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            xmlns:app="http://schemas.android.com/apk/res-auto"
            style="?attr/textInputOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/agent_api_key"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/agent_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/agent_provider_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- the levels the provider offers (AgentSheet fills it): a list to pick from, not
             typed into -->
        <com.google.android.material.textfield.TextInputLayout
            style="?attr/textInputOutlinedExposedDropdownMenuStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/agent_thinking_level">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/agent_thinking_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/agent_thinking_level_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputLayout
            style="?attr/textInputOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/agent_max_tokens">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/agent_max_tokens_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- the tokens the model has room for, for this provider; empty: found out
             (AgentSettings.contextWindow), the helper saying what that comes to now -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/agent_context_window_layout"
            style="?attr/textInputOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/agent_context_window">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/agent_context_window_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/agent_approval"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <RadioGroup
            android:id="@+id/agent_approval_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <RadioButton
                android:id="@+id/agent_approval_ask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/agent_approval_ask" />

            <RadioButton
                android:id="@+id/agent_approval_auto_edits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/agent_approval_auto_edits" />

            <RadioButton
                android:id="@+id/agent_approval_auto_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/agent_approval_auto_all" />

        </RadioGroup>

    </LinearLayout>

</ScrollView>
