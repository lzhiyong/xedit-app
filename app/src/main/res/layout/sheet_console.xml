<?xml version="1.0" encoding="utf-8"?>
<!-- The console (ConsoleSheet): output by channel, errors, build. The text is in the
     app's own JetBrains Mono: the system's "monospace" is not monospace on every device
     (a font theme may replace it), and the columns of the log would not line up. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- the header: the title, the tabs. Only a drag that starts here moves the sheet
         (ConsoleSheet): one on the pages scrolls them and never closes it. No handle is
         drawn: the whole header is what drags. -->
    <LinearLayout
        android:id="@+id/console_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/console_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/console_copy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_action_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/console_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_action_clear" />

        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/console_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="fixed" />

    </LinearLayout>

    <!-- The three pages are equally high (ConsoleSheet.show sets it), so the sheet does not
         change its height with the tab: what is above the text of a page (chips, the
         command) takes its room from the text, and "no errors" stands in the middle. -->

    <!-- output: the channels, the lines of the one chosen -->
    <LinearLayout
        android:id="@+id/console_output_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/console_channels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />

        </HorizontalScrollView>

        <!-- one axis per gesture, and as high as the page with a single line too, so that
             a drag anywhere scrolls (see ConsoleScrollView) -->
        <x.editor.app.view.ConsoleScrollView
            android:id="@+id/console_output_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <!-- lines are not wrapped: the text scrolls across too -->
            <x.editor.app.view.ConsoleHorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="never">

                <TextView
                    android:id="@+id/console_output_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_regular"
                    android:padding="12dp"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

            </x.editor.app.view.ConsoleHorizontalScrollView>

        </x.editor.app.view.ConsoleScrollView>

    </LinearLayout>

    <!-- errors: the diagnostics of the open documents, the errors of the last build -->
    <FrameLayout
        android:id="@+id/console_problems_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <ListView
            android:id="@+id/console_problems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null" />

        <TextView
            android:id="@+id/console_problems_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/console_problems_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

    </FrameLayout>

    <!-- build: a command run with the app's own toolchain or in Termux, what it printed -->
    <LinearLayout
        android:id="@+id/console_build_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- the builds, one chip per project (or file): whether it runs, for how long; the
             one shown checked. Builds of different projects run side by side. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/console_jobs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp">

            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/console_command_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/console_command"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_regular"
                    android:imeOptions="actionGo"
                    android:inputType="text|textNoSuggestions"
                    android:singleLine="true"
                    android:textSize="13sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/console_run"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/console_action_run" />

        </LinearLayout>

        <!-- one axis per gesture, and as high as the page with a single line too, so that
             a drag anywhere scrolls (see ConsoleScrollView) -->
        <x.editor.app.view.ConsoleScrollView
            android:id="@+id/console_build_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <!-- lines are not wrapped: the text scrolls across too -->
            <x.editor.app.view.ConsoleHorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="never">

                <TextView
                    android:id="@+id/console_build_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_regular"
                    android:padding="12dp"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

            </x.editor.app.view.ConsoleHorizontalScrollView>

        </x.editor.app.view.ConsoleScrollView>

    </LinearLayout>

</LinearLayout>
