// Your keyboard shortcuts, written as in Neovim. Every shortcut is here, the ones the app
// starts with too: change them, add your own, delete what you do not want. This file is
// read again when it is saved. A hardware keyboard, a soft keyboard with Ctrl/Alt keys of
// its own, and Ctrl and Alt of the row of extra keys (tap: the next key; hold: until
// tapped again) all press the same keys.
//
// Keys:   <C-s> Ctrl+S   <A-z> Alt+Z (also <M-z>)   <D-k> Meta (Super, Windows)+K
//         <C-S-f> Ctrl+Shift+F   <C-/> Ctrl+/   <F5>   <C-Space>   <S-Tab>
//         Named keys: F1–F12, Up, Down, Left, Right, Home, End, PageUp, PageDown,
//         Insert, Del, BS, Tab, CR, Esc, Space, and <lt> < , <Bslash> \ , <Bar> |
//         A char Shift makes is written as it is: <C-?>, not <C-S-/>.
//         Several keys one after the other: "<C-k>c", "<leader>f" (the first must have
//         Ctrl, Alt or Meta, or be F1–F12; the ones after it may be plain).
//
// Each mapping: "keys", and either
//   "action": one of the actions below, or
//   "insert": text put in at the cursor, in place of the selection: snippet syntax,
//             Tab moves through $1, ${1:default}; $0 is where the cursor ends;
//             ${TM_SELECTED_TEXT} is the selected text, ${CLIPBOARD} the clipboard.
//   "desc" is for you: what it is for (optional; shown in the list of shortcuts).
//   "group" is the tab of the shortcuts sheet it is listed in (optional): edit, code,
//           file, insert, or a tab of your own (named in "groups", or by the mapping).
// "groups" (next to "keymaps") lists the tabs of your own, shown even while empty;
// New on the shortcuts sheet adds one.
// A later mapping of the same keys replaces an earlier one; "nop" takes keys away.
//
// Actions:
{{actions}}
//
// Comments like these, and a comma after the last item, are allowed.
{
  // the format of this file (the app may bring an older one up to date)
  "version": 3,
  // what <leader> stands for in "keys"
  "leader": "<C-k>",
  // how long (ms) the next key of a sequence is waited for
  "timeoutlen": 1000,

  "keymaps": [
    // edit
    { "keys": "<C-c>",   "action": "copy" },
    { "keys": "<C-x>",   "action": "cut" },
    { "keys": "<C-v>",   "action": "paste" },
    { "keys": "<C-a>",   "action": "select_all" },
    { "keys": "<C-z>",   "action": "undo" },
    { "keys": "<C-y>",   "action": "redo" },
    { "keys": "<C-S-z>", "action": "redo" },

    // code
    { "keys": "<C-/>",   "action": "toggle_comment" },
    { "keys": "<C-S-f>", "action": "format" },
    { "keys": "<C-S-o>", "action": "outline" },
    { "keys": "<F5>",    "action": "run" },
    { "keys": "<C-`>",   "action": "console" },

    // file and view
    { "keys": "<C-s>",   "action": "save" },
    { "keys": "<C-o>",   "action": "open_file" },
    { "keys": "<C-f>",   "action": "search" },
    { "keys": "<C-g>",   "action": "goto_line" },
    { "keys": "<A-z>",   "action": "wordwrap" },
    { "keys": "<F11>",   "action": "fullscreen" },

    // your own, for example:
    // { "keys": "<leader>r", "action": "read_only", "desc": "Read-only on or off" },
    // { "keys": "<C-b>", "insert": "**${TM_SELECTED_TEXT}$0**", "desc": "Bold (Markdown)" },
    // { "keys": "<C-S-l>", "insert": "console.log($0);" },
  ],
}
