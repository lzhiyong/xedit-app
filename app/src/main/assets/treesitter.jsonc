// Where the tree-sitter resources come from and where they go (TreeSitterResources).
// Read with comments and trailing commas allowed.
//
//   {arch}  the architecture of the device: aarch64, arm, x86_64 or x86.
//   {home}  the app's home, /data/data/<package>/files/home (AppDirs).
//
// "root" is where the resources go. A package's "target" is a directory below the root
// ("." is the root itself), or a path of its own that starts with {home} (the
// friendly-snippets of the completion, in {home}/lsp/friendly-snippets). A package owns
// the entries at the top of its zip (configs: config/ and themes/), and only those are
// replaced when it is updated.
{
  "root": "{home}/treesitter",
  "packages": [
    // the file types, and the highlight themes (config/, themes/)
    {
      "id": "configs",
      "url": "https://github.com/lzhiyong/tree-sitter-parser/releases/download/android-tree-sitter/tree-sitter-configs.zip",
      "target": "."
    },
    // the grammars, built for this device
    {
      "id": "languages",
      "url": "https://github.com/lzhiyong/tree-sitter-parser/releases/download/android-tree-sitter/tree-sitter-languages-{arch}.zip",
      "target": "{arch}"
    },
    // the highlighting queries of the grammars
    {
      "id": "queries",
      "url": "https://github.com/lzhiyong/tree-sitter-parser/releases/download/android-tree-sitter/tree-sitter-queries.zip",
      "target": "queries"
    },
    // friendly-snippets, for the completion
    {
      "id": "snippets",
      "url": "https://github.com/lzhiyong/tree-sitter-parser/releases/download/android-tree-sitter/tree-sitter-snippets.zip",
      "target": "{home}/lsp/friendly-snippets"
    }
  ],
  "update": {
    // how often the packages are looked at for a new version
    "checkIntervalHours": 12,
    // on a metered network, an update of a package larger than this (bytes) waits for an
    // unmetered one (a package that is missing is downloaded all the same)
    "meteredMaxBytes": 2097152
  }
}
